user hv2-control-plane on #<sha256-of-password> resetkeys resetchannels -@all ~hv2:redisacl-fe3302fc217b:nodes ~hv2:redisacl-fe3302fc217b:node:* ~hv2:redisacl-fe3302fc217b:sandboxes ~hv2:redisacl-fe3302fc217b:sandbox:* ~hv2:redisacl-fe3302fc217b:public-ports ~hv2:redisacl-fe3302fc217b:ports:* ~hv2:redisacl-fe3302fc217b:private-membership:* ~hv2:redisacl-fe3302fc217b:web-sharing:* ~hv2:redisacl-fe3302fc217b:private-addresses:* ~hv2:redisacl-fe3302fc217b:name-reservations ~hv2:redisacl-fe3302fc217b:reserved-names:* ~hv2:redisacl-fe3302fc217b:domains ~hv2:redisacl-fe3302fc217b:domains:* ~hv2:redisacl-fe3302fc217b:events ~hv2:redisacl-fe3302fc217b:usage:since ~hv2:redisacl-fe3302fc217b:usage:open ~hv2:redisacl-fe3302fc217b:usage:closed ~hv2:redisacl-fe3302fc217b:environments ~hv2:redisacl-fe3302fc217b:webhooks ~hv2:redisacl-fe3302fc217b:deliveries:* ~hv2:redisacl-fe3302fc217b:team-telemetry ~hv2:redisacl-fe3302fc217b:managed-keys ~hv2:redisacl-fe3302fc217b:managed-key-ids ~hv2:redisacl-fe3302fc217b:managed-key-tombstones +@read +@write +@transaction +@connection +eval +evalsha +script|load -@dangerous
user hv2-node on #<sha256-of-password> resetkeys resetchannels -@all ~hv2:redisacl-fe3302fc217b:nodes ~hv2:redisacl-fe3302fc217b:node:* ~hv2:redisacl-fe3302fc217b:sandboxes ~hv2:redisacl-fe3302fc217b:sandbox:* ~hv2:redisacl-fe3302fc217b:public-ports ~hv2:redisacl-fe3302fc217b:ports:* ~hv2:redisacl-fe3302fc217b:private-membership:* ~hv2:redisacl-fe3302fc217b:web-sharing:* ~hv2:redisacl-fe3302fc217b:private-addresses:* ~hv2:redisacl-fe3302fc217b:name-reservations ~hv2:redisacl-fe3302fc217b:reserved-names:* ~hv2:redisacl-fe3302fc217b:domains ~hv2:redisacl-fe3302fc217b:domains:* ~hv2:redisacl-fe3302fc217b:events ~hv2:redisacl-fe3302fc217b:usage:since ~hv2:redisacl-fe3302fc217b:usage:open ~hv2:redisacl-fe3302fc217b:usage:closed ~hv2:redisacl-fe3302fc217b:environments ~hv2:redisacl-fe3302fc217b:webhooks ~hv2:redisacl-fe3302fc217b:deliveries:* +@read +@write +@transaction +@connection +eval +evalsha +script|load -@dangerous
user hv2-gateway on #<sha256-of-password> resetkeys resetchannels -@all %R~hv2:redisacl-fe3302fc217b:nodes %R~hv2:redisacl-fe3302fc217b:node:* %R~hv2:redisacl-fe3302fc217b:sandboxes %R~hv2:redisacl-fe3302fc217b:sandbox:* %R~hv2:redisacl-fe3302fc217b:public-ports %R~hv2:redisacl-fe3302fc217b:ports:* +@read +@connection +eval_ro +evalsha_ro +eval +evalsha +script|load -@dangerous
user default off
user hv2-admin on #<sha256-of-password> ~* &* +@all
user hv2-shared on #<sha256-of-password> ~hv2:redisacl-fe3302fc217b:* +@all
