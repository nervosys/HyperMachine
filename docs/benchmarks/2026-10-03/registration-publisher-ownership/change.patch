 mod adoption_claim_tests {
     use super::*;
+    #[tokio::test]
+    async fn cancelled_publication_releases_initial_publisher_ownership() {
+        let flag=Arc::new(std::sync::atomic::AtomicBool::new(true));
+        let active=flag.clone();let ready=Arc::new(tokio::sync::Notify::new());let signal=ready.clone();
+        let task=tokio::spawn(async move {
+            let _publication=RegistrationPublication(active);
+            signal.notify_one();std::future::pending::<()>().await;
+        });
+        ready.notified().await;
+        assert!(flag.load(std::sync::atomic::Ordering::Acquire));
+        task.abort();assert!(task.await.unwrap_err().is_cancelled());
+        assert!(!flag.load(std::sync::atomic::Ordering::Acquire));
+    }
+    #[test]
+    fn completed_publication_releases_initial_publisher_ownership() {
+        let flag=Arc::new(std::sync::atomic::AtomicBool::new(true));
+        { let _publication=RegistrationPublication(flag.clone());assert!(flag.load(std::sync::atomic::Ordering::Acquire)); }
+        assert!(!flag.load(std::sync::atomic::Ordering::Acquire));
+    }
