{
  "success": true,
  "purpose": "functional verification of a sandbox's command history on KVM; no timing claim",
  "input_sha256": {
    "daemon": "8e200210a759f0492beeb388f68d59c232bbf165e41552da5f99bbc6c534c497",
    "kernel": "afaa2129c3eacc519fd1ca35fe8bfc47e6c44251b5840d504f1e140705daebdd",
    "initrd": "36b4f2f4ae1d56875302731d95494130173997cdb022e6db0f90ee5e503c27b0",
    "driver": "e110eaf36d1277d34722fdb612e0b1a079483eee05fb3642940faa8248e54f1b"
  },
  "e2b_sdk": "2.51.0",
  "cases": [
    {
      "name": "a command run through exec is kept, with its exit code and output",
      "success": true,
      "detail": {
        "command": {
          "n": 1,
          "source": "exec",
          "state": "exited",
          "exitCode": 4
        }
      }
    },
    {
      "name": "commands run through the E2B SDK are kept, a killed one as signalled",
      "success": true,
      "detail": {
        "sdk_command": {
          "n": 3,
          "source": "process",
          "cmd": "/bin/bash -l -c echo from-sdk; sleep 0.2; echo done",
          "pid": 66,
          "state": "exited"
        },
        "killed": {
          "n": 4,
          "state": "signalled",
          "signal": 9
        }
      }
    },
    {
      "name": "a command line's secrets are masked before it is kept",
      "success": true,
      "detail": {
        "kept_as": "TOKEN=[redacted] true --password [redacted] https://[redacted]@h.example/x"
      }
    },
    {
      "name": "a sandbox created with commandHistory off keeps none",
      "success": true,
      "detail": {
        "refused": "sbx-1a28ca2e312f4472a38a was created with commandHistory off, and keeps none"
      }
    },
    {
      "name": "a command that printed more than is kept: every byte counted, the newest kept",
      "success": true,
      "detail": {
        "stdoutBytes": 204800,
        "dropped": 139264
      }
    },
    {
      "name": "paused and resumed on the same node, its commands are still there",
      "success": true,
      "detail": {
        "commands": 6
      }
    },
    {
      "name": "paused into the store and resumed on the other node, its commands come too",
      "success": true,
      "detail": {
        "carried": 6,
        "next": 7
      }
    },
    {
      "name": "what cannot be read is refused, and a deleted sandbox's commands go",
      "success": true,
      "detail": {
        "refused": {
          "no such command": "sandbox sbx-b16216b1bbbb44b7bc8d has no command 9999",
          "no such sandbox": "no sandbox sbx-absent",
          "a deleted sandbox": "no sandbox sbx-b16216b1bbbb44b7bc8d"
        }
      }
    }
  ]
}
