+        return redis.error_reply('named registration index type mismatch')
+    end
+end
+redis.call('SET', KEYS[2], ARGV[4])
+redis.call('SADD', KEYS[3], ARGV[3])
+redis.call('HSET', KEYS[1], ARGV[1], ARGV[5])
+redis.call('SADD', KEYS[4], ARGV[1])
+return 1
