+    #[test]
+    fn host_connection_lifecycle_notifies_observers_even_before_they_wait() {
+        use std::time::{Duration, Instant};
+        let mut device = VsockDevice::new(3).unwrap();
+        let progress = device.progress();
+        for operation in 0..3 {
+            let id = device.connect_ephemeral(1024).unwrap();
+            let seen = progress.current();
+            match operation {
+                0 => device.close(id).unwrap(),
+                1 => device.forget(id),
+                _ => device.reset(),
+            }
+            assert_ne!(progress.current(), seen, "lifecycle operation {operation}");
+            let start = Instant::now();
+            assert_ne!(progress.wait_past(seen, Duration::from_secs(2)), seen);
+            assert!(start.elapsed() < Duration::from_secs(1));
+        }
+    }
