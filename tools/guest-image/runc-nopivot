#!/bin/sh
# runc without pivot_root, for a guest whose root is an initramfs: the kernel
# will not pivot away from the initial rootfs (EINVAL), so a container is
# entered with MS_MOVE and chroot instead. Docker is told to use this as an
# default runtime (daemon.json), and it is also installed as `runc` itself since
# BuildKit's executor (docker build, compose build) runs `runc` from PATH and
# ignores the default runtime. Everything else is runc's.
real=/usr/local/bin/runc-real
n=$#
i=0
ins=""
while [ "$i" -lt "$n" ]; do
    a=$1
    shift
    set -- "$@" "$a"
    i=$((i + 1))
    case "$a" in
        create|run)
            if [ -z "$ins" ]; then
                set -- "$@" --no-pivot
                ins=1
            fi
            ;;
    esac
done
exec "$real" "$@"
