#!/bin/busybox sh
# PID 1 of the URL-tracing guest (docs/URL_TRACING.md). Like `init`, except that:
#   - only the few busybox applets this script needs are linked into /bin
#     (the stock init runs `busybox --install`, which links about 400);
#   - no shell is left on the console afterwards;
#   - nothing is exported to the agent's environment but PATH and HOME.
# `/bin/sh` itself stays: the node's exec API runs every command as `sh -c`, so
# the guest agent cannot start the tracer without one.
B=/bin/busybox
for applet in mount mkdir ln ip sleep; do
    $B ln -sf busybox /bin/$applet
done
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /etc /tmp /root
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
mount -o remount,size=90% / 2>/dev/null

# The kernel configured the network from `ip=` on its command line and wrote the
# nameserver to /proc/net/pnp, which is in resolv.conf's own format.
[ -e /etc/resolv.conf ] || ln -s /proc/net/pnp /etc/resolv.conf
ip link set lo up 2>/dev/null

export PATH=/bin HOME=/root
/bin/hv2-guest-agentd &
echo "=== HV2 READY ==="
# Stay alive as PID 1; there is no console shell.
while :; do
    sleep 3600
done
