# Cross-platform line ending normalization
* text=auto eol=lf

# Rust sources
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf

# Documentation
*.md text eol=lf
*.rst text eol=lf
*.txt text eol=lf

# CI / Config
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts — keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.wasm binary

# Preserve exact recorded diagnostic coordinator bytes for its SHA256.
docs/benchmarks/2026-09-30/owner-load-coordinator.py -text whitespace=cr-at-eol

docs/benchmarks/2026-09-30/owner-pinned-load-coordinator.py -text whitespace=cr-at-eol

# Preserve exact startup diagnostic evidence and source hashes.
docs/benchmarks/2026-10-01/* -text whitespace=cr-at-eol
# Raw Cargo transcripts intentionally end with a blank line.
docs/benchmarks/2026-10-01/kvm-events-abi-test.txt -text whitespace=cr-at-eol,-blank-at-eof
docs/benchmarks/2026-10-01/kvm-events-direct-test.txt -text whitespace=cr-at-eol,-blank-at-eof
docs/benchmarks/2026-10-01/tcp-build*-output.txt -text whitespace=cr-at-eol,-blank-at-eof
